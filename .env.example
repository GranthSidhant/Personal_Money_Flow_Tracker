# Flask configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database configuration
# Local development default: sqlite:///instance/money_tracker.db
DATABASE_URL=sqlite:///instance/money_tracker.db

# Production example:
# DATABASE_URL=postgresql://user:password@localhost:5432/money_tracker

# Optional AI configuration (Phase 7)
GEMINI_API_KEY=

# File Upload and Storage
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

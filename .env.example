# -----------------------------------------------------------------------------
# Personal Money Flow Tracker - Environment Configuration Template
# -----------------------------------------------------------------------------

# Application Environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# Secret Key used for session encryption and CSRF tokens.
# GENERATE A STRONG CRYPTOGRAPHIC KEY FOR PRODUCTION (e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`):
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Connection URL:
# For SQLite (default local development):
# DATABASE_URL=sqlite:///instance/money_tracker.db
# For PostgreSQL (production deployment):
# DATABASE_URL=postgresql://user:password@localhost:5432/money_flow_db
DATABASE_URL=sqlite:///instance/money_tracker.db

# Optional Google Gemini API key for AI Transactions Inbox:
# Leave blank to use the built-in local heuristic rule engine (free, offline, no paid API required).
GEMINI_API_KEY=

# Upload folder for secure audio notes and attachments (relative to repository or absolute):
UPLOAD_FOLDER=uploads

# Maximum upload payload size in bytes (default 16MB):
MAX_CONTENT_LENGTH=16777216

# Production Port (default 5000):
PORT=5000
